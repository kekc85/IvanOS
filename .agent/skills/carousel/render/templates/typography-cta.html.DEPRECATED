<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    width: 1080px;
    height: 1350px;
    background: {{ACCENT_COLOR}};
    font-family: 'Inter', sans-serif;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 100px;
    overflow: hidden;
    color: white;
    text-align: center;
  }
  .cta-action {
    font-size: 42pt;
    font-weight: 400;
    margin-bottom: 30px;
    opacity: 0.9;
  }
  .cta-keyword {
    font-size: 140pt;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -3px;
    margin-bottom: 40px;
  }
  .cta-arrow {
    font-size: 80pt;
    font-weight: 700;
    margin-bottom: 30px;
  }
  .cta-reward {
    font-size: 36pt;
    font-weight: 400;
    line-height: 1.3;
    max-width: 850px;
    opacity: 0.95;
  }
  .signature {
    position: absolute;
    bottom: 60px;
    left: 60px;
    font-size: 24pt;
    opacity: 0.8;
  }
</style>
</head>
<body>
  <div class="cta-action">{{CTA_ACTION}}</div>
  <div class="cta-keyword">{{CTA_KEYWORD}}</div>
  <div class="cta-arrow">{{CTA_ARROW}}</div>
  <div class="cta-reward">{{CTA_REWARD}}</div>
  <div class="signature">— {{AUTHOR_NAME}}</div>
</body>
</html>