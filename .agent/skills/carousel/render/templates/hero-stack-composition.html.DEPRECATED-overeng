<!DOCTYPE html>
<html lang="{{lang}}">
<head>
<meta charset="UTF-8">
<title>Hero Stack Composition (P3)</title>
<style>
  :root {
    --brand-primary: {{brand_primary}};
    --brand-accent: {{brand_accent}};
    --brand-text-light: #ffffff;
    --brand-text-dark: #0a0a0a;
    --canvas-bg: {{canvas_bg}};
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 1080px; height: 1350px; overflow: hidden; font-family: 'Inter', 'Helvetica Neue', sans-serif; }

  .slide {
    width: 1080px;
    height: 1350px;
    position: relative;
    background: var(--canvas-bg);
    background-image:
      radial-gradient(ellipse at top, rgba(255,255,255,0.06), transparent 60%),
      url('{{bg_texture_url}}');
    background-size: cover;
    background-blend-mode: overlay;
    padding: 60px;
    display: flex;
    flex-direction: column;
  }

  .top-label {
    color: var(--brand-text-light);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 16px;
  }

  .stack-title {
    color: var(--brand-text-light);
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: 92px;
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin-bottom: 40px;
  }
  .stack-title .accent {
    color: var(--brand-primary);
    font-style: italic;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 36px;
    flex: 1;
  }

  .stack-item {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 14px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    backdrop-filter: blur(8px);
    min-height: 220px;
  }

  .stack-item .logo {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    background-image: url('{{stack_logo_url}}');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    background-color: rgba(255,255,255,0.92);
  }

  .stack-item .label {
    color: var(--brand-text-light);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.1;
  }

  .stack-item .price {
    color: var(--brand-primary);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-top: 6px;
  }

  .equation-bar {
    background: var(--brand-primary);
    color: var(--brand-text-light);
    padding: 28px 36px;
    border-radius: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
  }

  .equation-bar .label {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .equation-bar .total {
    font-size: 56px;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .footnote {
    color: var(--brand-text-light);
    font-size: 24px;
    font-weight: 500;
    opacity: 0.6;
    text-align: center;
  }

  .corner-counter {
    position: absolute;
    top: 60px;
    right: 60px;
    color: var(--brand-text-light);
    font-size: 22px;
    font-weight: 500;
    opacity: 0.6;
  }
</style>
</head>
<body>
  <div class="slide">
    <div class="corner-counter">{{slide_counter}}</div>

    <div class="top-label">{{top_label}}</div>
    <h1 class="stack-title">{{stack_title_html}}</h1>

    <div class="stack-grid">
      {{stack_items_html}}
    </div>

    <div class="equation-bar">
      <span class="label">{{equation_label}}</span>
      <span class="total">{{equation_total}}</span>
    </div>

    <div class="footnote">{{footnote}}</div>
  </div>
</body>
</html>