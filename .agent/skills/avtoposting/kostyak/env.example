# ── АВТОПОСТИНГ: твои ключи ───────────────────────────────────────────────
# Скопируй этот файл рядом под именем .env и заполни. Пустое поле = площадка
# просто выключена, движок это скажет прямо и работать не перестанет.
# .env НИКОГДА не попадает в репозиторий и никому не показывается: это ключи
# от твоих аккаунтов, а не настройки

# ── TELEGRAM ──────────────────────────────────────────────────────────────
# токен бота: получаешь у BotFather командой /newbot
TELEGRAM_BOT_TOKEN=
# куда публикуем: @adres_kanala для публичного, -100... для закрытого
# бот обязан быть администратором этого канала с правом публикации
TELEGRAM_CHAT_ID=
# адрес API. Меняешь ТОЛЬКО если твоя сеть режет облачный адрес:
# тогда поднимаешь свой Bot API server и пишешь сюда его адрес
TELEGRAM_API_BASE=https://api.telegram.org

# ── INSTAGRAM ─────────────────────────────────────────────────────────────
# номер профессионального аккаунта (его показывает доктор после первой связки)
IG_USER_ID=
# токен доступа со скоупами instagram_business_basic
# и instagram_business_content_publish, живёт 60 дней
IG_ACCESS_TOKEN=
# graph.instagram.com = вход по инстаграм-логину (без страницы Facebook)
IG_API_BASE=https://graph.instagram.com
IG_API_VERSION=v23.0

# ── VK ────────────────────────────────────────────────────────────────────
# токен с правом публикации в твоём сообществе
VK_ACCESS_TOKEN=
# номер сообщества, БЕЗ минуса: минус движок поставит сам
VK_GROUP_ID=
VK_API_BASE=https://api.vk.com
VK_API_VERSION=5.199

# ── ПУБЛИЧНЫЙ АДРЕС МЕДИА (нужен Instagram, он качает файл сам) ────────────
# ready = ссылки уже публичные, git = публичный репозиторий, ssh = свой сервер
MEDIA_MODE=ready
# адрес, по которому видны выложенные файлы (без слеша в конце)
MEDIA_PUBLIC_BASE=
# для MEDIA_MODE=git: локальная папка публичного репозитория
MEDIA_GIT_DIR=
MEDIA_GIT_SUBDIR=media
MEDIA_GIT_BRANCH=main
# для MEDIA_MODE=ssh: куда класть файл, вида пользователь@сервер:/путь/в/вебе
MEDIA_SSH_TARGET=

# ── СЕТЬ И РАБОЧИЙ ДОМ ────────────────────────────────────────────────────
# прокси, если прямой канал закрыт: http://адрес:порт или socks5://адрес:порт
AUTOPOST_PROXY=
AUTOPOST_TIMEOUT=30
AUTOPOST_RETRIES=2
# где лежат очередь и лог. Пусто = ~/.autopost, вне папки движка
AUTOPOST_HOME=
