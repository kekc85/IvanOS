# Настройки движка воронок. Скопируй в .env и заполни то, что нужно.
# Обязательна ровно одна строка - токен бота. Остальное включается по мере надобности.

# --- обязательное ------------------------------------------------------------
# Токен получаешь у @BotFather: /newbot, придумываешь имя, он присылает строку вида
# 1234567890:AA... Вставь её сюда целиком, без кавычек
BOT_TOKEN=

# --- полезное ----------------------------------------------------------------
# Твой chat_id в Telegram: туда бот пересылает живые сообщения людей и отчёты рассылок.
# Узнать: напиши боту @userinfobot, он ответит числом
ADMIN_CHAT_ID=0

# Где лежит база контактов и где искать воронки. Дефолты рядом с движком
# DB_PATH=/opt/voronka/voronka.sqlite
# FUNNELS_DIR=/opt/voronka/funnels

# Воронка, в которую попадает человек, написавший боту без кодового слова.
# Пусто - бот ответит нейтрально и никуда не поведёт
DEFAULT_FUNNEL_KEY=

# --- короткие ссылки ---------------------------------------------------------
# Адрес, по которому наружу видны короткие ссылки клик-трекинга. Без домена оставь
# пустым: кнопки будут вести напрямую, счётчик кликов просто не наберётся
REDIRECT_BASE=

# --- ссылки, которые бот подставляет в тексты --------------------------------
# Используются в цепочке после регистрации. Пусто - соответствующая кнопка не рисуется,
# и это лучше кнопки в никуда
WELCOME_CABINET_URL=
WELCOME_VIP_URL=
WELCOME_ANKETA_URL=
WELCOME_CHANNEL_URL=

# --- необязательное ----------------------------------------------------------
# Ключ модели для ИИ-ответчика. Пусто - ответчик выключен, живые сообщения людей
# просто пересылаются тебе. Персона вписывается в app/ai_responder.py
ANTHROPIC_API_KEY=

# Адрес трекера ошибок Sentry. Пусто - ошибки пишутся только в журнал службы
SENTRY_DSN=
